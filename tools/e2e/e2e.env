# Test-only values for the throwaway e2e server (tools/e2e/compose.yml). Nothing here protects
# anything real: the server listens on 127.0.0.1 only. Plain KEY=VALUE lines: docker compose and
# the Python tools (kit.py) both read this file.
APP_PORT=3990
BOFAULT_PORT=3991
APP_URL=http://127.0.0.1:3990
CLIENT_URL=http://127.0.0.1:3990
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=orbify-e2e
POSTGRES_DB=bookorbit
JWT_SECRET=orbify-e2e-jwt-secret-000000000000000000000000
SETUP_BOOTSTRAP_TOKEN=orbify-e2e-setup-token
E2E_USER=reader
E2E_PASSWORD=Orbify-e2e-1
E2E_KOSYNC_USER=reader
E2E_KOSYNC_PASSWORD=Orbify-kosync-1
# Login is throttled (5 a minute): kit.py signs in once and keeps the token for a day.
JWT_EXPIRES_IN=24h
