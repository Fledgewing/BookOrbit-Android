{
  "version": 1,
  "about": "The BookSync KOReader plugin <-> BookSync Companion contract (android/docs/INTERFACE.md is the human view). Both sides test against this file: ContractTest.kt and test_flows.lua 'contract'. Change it with both sides in the same change.",
  "package": "net.fledgewing.orbitcompanion",
  "authority": "net.fledgewing.orbitcompanion.commands",
  "common_extras": [
    "proto",
    "sender",
    "patch_version"
  ],
  "answer": [
    "ok",
    "why",
    "status",
    "key",
    "proof",
    "id",
    "body",
    "owner",
    "pending"
  ],
  "commands": [
    {
      "name": "NET_UP",
      "method": "net.fledgewing.orbitcompanion.action.NET_UP",
      "extras": [
        "reason",
        "request_id",
        "wifi",
        "tailscale",
        "wake_lock_s",
        "owner",
        "mode"
      ],
      "does": "Wi-Fi on (if asked), a wake lock up to 25 s, Tailscale's connect"
    },
    {
      "name": "NET_DONE",
      "method": "net.fledgewing.orbitcompanion.action.NET_DONE",
      "extras": [
        "reason",
        "ok",
        "seconds",
        "detail",
        "restore"
      ],
      "does": "the sync is over: release the wake lock, apply Wi-Fi after a sleep sync"
    },
    {
      "name": "WIFI_OFF",
      "method": "net.fledgewing.orbitcompanion.action.WIFI_OFF",
      "extras": [
        "reason",
        "auto",
        "mode"
      ],
      "does": "Wi-Fi off (an automatic off is refused while the reader owns Wi-Fi)"
    },
    {
      "name": "SLEEP_NOW",
      "method": "net.fledgewing.orbitcompanion.action.SLEEP_NOW",
      "extras": [
        "reason"
      ],
      "does": "lock the screen (device admin force-lock), at most once per 5 s"
    },
    {
      "name": "SETTINGS",
      "method": "net.fledgewing.orbitcompanion.action.SETTINGS",
      "extras": [
        "values",
        "settings_at",
        "reading_schedule",
        "reading_schedule_applied_at"
      ],
      "does": "the shared settings, newest per key wins"
    },
    {
      "name": "STATS",
      "method": "net.fledgewing.orbitcompanion.action.STATS",
      "extras": [
        "pages",
        "full",
        "partial",
        "content",
        "open",
        "reading",
        "wifi_mode",
        "reading_schedule",
        "reason"
      ],
      "does": "battery stats batch and the reading gate"
    },
    {
      "name": "RELAUNCH",
      "method": "net.fledgewing.orbitcompanion.action.RELAUNCH",
      "extras": [
        "reason"
      ],
      "does": "the plugin is quitting for a restart: start KOReader again"
    },
    {
      "name": "SETUP_LATER",
      "method": "net.fledgewing.orbitcompanion.action.SETUP_LATER",
      "extras": [],
      "does": "the setup box's Later"
    },
    {
      "name": "REPORT",
      "method": "net.fledgewing.orbitcompanion.action.REPORT",
      "extras": [
        "signed_in",
        "recommended",
        "conflicts",
        "reason"
      ],
      "does": "signed in yes/no and the recommended settings' state, for two Setup rows"
    },
    {
      "name": "SLEEP_POOL",
      "method": "net.fledgewing.orbitcompanion.action.SLEEP_POOL",
      "extras": [
        "reason",
        "wake"
      ],
      "does": "the sleep screen's files changed, or KOReader woke from a real sleep"
    },
    {
      "name": "STORAGE",
      "method": "net.fledgewing.orbitcompanion.action.STORAGE",
      "extras": [
        "reason",
        "limit",
        "mirror_covers"
      ],
      "does": "count what BookSync stores and remove the oldest over the limit"
    },
    {
      "name": "SLEEP_REFRESH",
      "method": "net.fledgewing.orbitcompanion.action.SLEEP_REFRESH",
      "extras": [
        "reason",
        "from",
        "rules",
        "open_id",
        "every",
        "storage_limit_mb",
        "scopes_only"
      ],
      "does": "refresh the sleep pool or pickers through the companion-owned login; no plugin credentials",
      "login": false
    },
    {
      "name": "SQLITE_STRESS",
      "method": "net.fledgewing.orbitcompanion.action.SQLITE_STRESS",
      "extras": [
        "seconds"
      ],
      "does": "debug: the shared-storage SQLite stress writer"
    },
    {
      "name": "PATCH",
      "method": "net.fledgewing.orbitcompanion.action.PATCH",
      "extras": [
        "reason",
        "drain_events",
        "events_ack"
      ],
      "does": "publish bounded read-model requests and acknowledge durable event batches"
    },
    {
      "name": "UPDATE",
      "method": "net.fledgewing.orbitcompanion.action.UPDATE",
      "extras": [
        "reason"
      ],
      "does": "check for an update: the companion, then the plugin of its release"
    }
  ],
  "calls": [
    {
      "name": "STATUS",
      "method": "net.fledgewing.orbitcompanion.call.STATUS",
      "caller": "koreader",
      "extras": [
        "patch_version",
        "book"
      ],
      "answer": [
        "status"
      ],
      "does": "the status JSON, while the companion's service runs"
    },
    {
      "name": "TAKE_COMMAND",
      "method": "net.fledgewing.orbitcompanion.call.TAKE_COMMAND",
      "caller": "koreader",
      "extras": [
        "command"
      ],
      "answer": [],
      "does": "did the companion put this command on KOReader's start? once"
    },
    {
      "name": "CLICKS",
      "method": "net.fledgewing.orbitcompanion.call.CLICKS",
      "caller": "koreader",
      "extras": [],
      "answer": [
        "key",
        "proof"
      ],
      "does": "a one-time key and proof for GET /clicks"
    },
    {
      "name": "RESTART_KOREADER",
      "method": "net.fledgewing.orbitcompanion.call.RESTART_KOREADER",
      "caller": "shell",
      "extras": [],
      "answer": [],
      "does": "USB only (tools/sideload-android.sh): restart KOReader the companion's way"
    },
    {
      "name": "SERVER_STATE",
      "method": "net.fledgewing.orbitcompanion.call.SERVER_STATE",
      "caller": "koreader-library",
      "extras": [
        "reload"
      ],
      "answer": [
        "owner",
        "body",
        "pending"
      ],
      "does": "bounded cached account state and opaque owner; reload refreshes identity without transport"
    },
    {
      "name": "SERVER_COMMAND",
      "method": "net.fledgewing.orbitcompanion.call.SERVER_COMMAND",
      "caller": "koreader-library",
      "extras": [
        "op",
        "args"
      ],
      "answer": [
        "id"
      ],
      "does": "dispatch a neutral library command with bounded Lua arguments"
    },
    {
      "name": "SERVER_RESULT",
      "method": "net.fledgewing.orbitcompanion.call.SERVER_RESULT",
      "caller": "koreader-library",
      "extras": [
        "id"
      ],
      "answer": [
        "body"
      ],
      "does": "poll one bounded neutral command result"
    },
    {
      "name": "ACCOUNT_OPEN",
      "method": "net.fledgewing.orbitcompanion.call.ACCOUNT_OPEN",
      "caller": "koreader-library",
      "extras": [],
      "answer": [],
      "does": "open the companion account form"
    },
    {
      "name": "DEVICE_SETTINGS",
      "method": "net.fledgewing.orbitcompanion.call.DEVICE_SETTINGS",
      "caller": "koreader-library",
      "extras": [],
      "answer": [
        "body"
      ],
      "does": "one cached neutral device-settings record"
    },
    {
      "name": "LIBRARY_BOOTSTRAP",
      "method": "net.fledgewing.orbitcompanion.call.LIBRARY_BOOTSTRAP",
      "caller": "koreader",
      "extras": [
        "patch_version"
      ],
      "answer": [
        "body"
      ],
      "does": "one bounded local legacy retirement descriptor before plugin instances start"
    },
    {
      "name": "READER_COMPANION",
      "method": "net.fledgewing.orbitcompanion.call.READER_COMPANION",
      "caller": "koreader-library",
      "extras": [
        "patch_version"
      ],
      "answer": [
        "body"
      ],
      "does": "one neutral local reader status/helper snapshot; four rows, 16 KiB; no network or checklist scan"
    }
  ],
  "activities": [
    {
      "name": "SHOW_STATUS",
      "action": "net.fledgewing.orbitcompanion.action.SHOW_STATUS"
    },
    {
      "name": "SHOW_APPS",
      "action": "net.fledgewing.orbitcompanion.action.SHOW_APPS"
    },
    {
      "name": "SHOW_LAUNCHER",
      "action": "net.fledgewing.orbitcompanion.action.SHOW_LAUNCHER"
    },
    {
      "name": "SHOW_SETUP",
      "action": "net.fledgewing.orbitcompanion.action.SHOW_SETUP"
    },
    {
      "name": "SHOW_PIN",
      "action": "net.fledgewing.orbitcompanion.action.SHOW_PIN"
    },
    {
      "name": "RELAUNCH_UI",
      "action": "net.fledgewing.orbitcompanion.action.RELAUNCH_UI"
    },
    {
      "name": "SLEEP_PREVIEW",
      "action": "net.fledgewing.orbitcompanion.action.SLEEP_PREVIEW"
    },
    {
      "name": "SHOW_SLEEP",
      "action": "net.fledgewing.orbitcompanion.action.SHOW_SLEEP"
    },
    {
      "name": "READER_ACTION",
      "action": "net.fledgewing.orbitcompanion.action.READER_ACTION",
      "extras": [
        "booksync_action"
      ],
      "does": "explicit user-requested permission, protected settings, setup or recovery; isolated transparent result bridge; no helper writes"
    }
  ],
  "usb": [
    {
      "name": "RESET_PIN",
      "action": "net.fledgewing.orbitcompanion.action.RESET_PIN",
      "does": "remove the Settings PIN; a receiver that needs android.permission.DUMP (adb only)"
    }
  ],
  "koreader_start": {
    "extras": {
      "COMMAND": "net.fledgewing.orbitcompanion.extra.COMMAND",
      "FROM": "net.fledgewing.orbitcompanion.extra.FROM",
      "ROTATION": "net.fledgewing.orbitcompanion.extra.ROTATION"
    },
    "commands": [
      "home",
      "home_smart",
      "restart",
      "reopen_book",
      "signin",
      "recommended",
      "full_refresh",
      "sync_sleep",
      "test_sync_path"
    ]
  },
  "loopback": {
    "port": 47913,
    "paths": [
      "/clicks"
    ],
    "lines": [
      "ORBIT",
      "SERVICE",
      "CLICK",
      "SETTINGS"
    ]
  },
  "status": [
    "version",
    "proto",
    "mode",
    "caps",
    "settings",
    "values",
    "keymap",
    "clicker_service",
    "pin_locked",
    "vpn_lockdown",
    "reading_schedule_request",
    "setup_needed",
    "setup_prompt",
    "sleep",
    "want_choices"
  ],
  "files": [
    {
      "path": "koreader/settings/orbit-companion.json",
      "writer": "companion",
      "reader": "plugin",
      "format": "json",
      "what": "the status file: mode, caps, version, settings"
    },
    {
      "path": "koreader/settings/orbit-recommended.json",
      "writer": "companion",
      "reader": "companion",
      "format": "json",
      "what": "the recommended settings' rows"
    },
    {
      "path": "koreader/settings/orbit-cache/events/",
      "writer": "companion",
      "reader": "plugin",
      "format": "lua",
      "what": "one answer per file"
    },
    {
      "path": "koreader/settings/orbit-cache/copies/ask.lua",
      "writer": "companion",
      "reader": "companion",
      "format": "lua",
      "what": "the copies on the reader to check"
    },
    {
      "path": "koreader/settings/orbit-cache/stress-writer.lua",
      "writer": "companion",
      "reader": "plugin",
      "format": "lua",
      "what": "debug: the stress writer's result"
    },
    {
      "path": "koreader/settings/orbit-cache/stress.db",
      "writer": "companion",
      "reader": "plugin",
      "format": "sqlite",
      "what": "debug: the stress test's database"
    },
    {
      "path": "koreader/settings/orbit-sleep/pool.json",
      "writer": "companion",
      "reader": "plugin",
      "format": "json",
      "what": "the sleep screen's covers"
    },
    {
      "path": "koreader/settings/orbit-sleep/state.json",
      "writer": "companion",
      "reader": "plugin",
      "format": "json",
      "what": "what the sleep screen showed"
    },
    {
      "path": "koreader/settings/orbit-sleep/bag.lua",
      "writer": "companion",
      "reader": "plugin",
      "format": "lua",
      "what": "the shuffle bag"
    },
    {
      "path": "koreader/settings/orbit-sleep/leave_out.lua",
      "writer": "companion",
      "reader": "plugin",
      "format": "lua",
      "what": "Leave out's member ids"
    },
    {
      "path": "koreader/settings/orbit-sleep/scopes.json",
      "writer": "companion",
      "reader": "plugin",
      "format": "json",
      "what": "the pickers' scopes and collections"
    },
    {
      "path": "koreader/settings/orbit-sleep/tags.json",
      "writer": "companion",
      "reader": "plugin",
      "format": "json",
      "what": "the tag picker's counts"
    },
    {
      "path": "koreader/settings/orbit-sleep/current.json",
      "writer": "plugin",
      "reader": "companion",
      "format": "json",
      "what": "the open book's cover (its image file) and caption"
    },
    {
      "path": "koreader/settings/orbit-sleep/current.png",
      "writer": "plugin",
      "reader": "companion",
      "format": "png",
      "via": "current.json",
      "what": "The current book cover named by current.json"
    },
    {
      "path": "koreader/cache/bookorbit/",
      "pattern": "<id>_<version>.jpg and matching .etag",
      "writer": "plugin, companion",
      "reader": "companion",
      "format": "jpeg, etag",
      "what": "BookOrbit thumbnails and mirror covers"
    },
    {
      "path": "koreader/settings/orbit-sleep/covers/",
      "pattern": "<id>.jpg and matching .etag",
      "writer": "companion",
      "reader": "companion",
      "format": "jpeg, etag",
      "what": "Recommended sleep covers named by pool.json"
    },
    {
      "path": "koreader/settings/orbit-cache/events-batch.lua",
      "writer": "companion",
      "reader": "plugin",
      "format": "lua",
      "what": "bounded event mailbox: id and at most eight events; PATCH acknowledges id"
    },
    {
      "path": "koreader/settings/orbit-cache/events-batch-names.lua",
      "writer": "companion",
      "reader": "companion",
      "format": "lua",
      "what": "spool filenames belonging to the outstanding mailbox, for durable acknowledgement"
    },
    {
      "path": "koreader/settings/orbit-cache/plugin-state.lua",
      "writer": "companion",
      "reader": "companion",
      "format": "lua",
      "what": "legacy snapshot retained intact until account-scoped catalog workflow migration checkpoints its copies queue"
    }
  ],
  "db": {
    "file": "koreader/settings/orbit-cache/orbit.db",
    "writer": "companion",
    "reader": "plugin",
    "user_version": 1,
    "schema": "shared/fixtures/cache/schema.sql",
    "tables": [
      "meta",
      "books",
      "lists",
      "list_items",
      "entries",
      "cover_keep",
      "tags",
      "scopes",
      "leave_out",
      "jobs"
    ]
  },
  "reminders": {
    "version": 1,
    "lifetime": "device-local; independent of accounts and catalog revisions",
    "operations": [
      "reminders.draft",
      "reminders.list",
      "reminders.retry",
      "reminders.runtime",
      "reminders.add",
      "reminders.edit",
      "reminders.setEnabled",
      "reminders.delete",
      "reminders.claimDue",
      "reminders.respond",
      "reminders.sleep"
    ],
    "snapshot_bytes": 8192,
    "due_bytes": 1024,
    "time_limit": 8,
    "interval_limit": 1,
    "runtime": "coalesced owner, visible/sleeping/page/modal/presenting flags, input serial, idle age and suspend-aware capture time; at most one earlier lifecycle frame; no per-page IPC",
    "claim": "one-use opaque grant tied to current owner, record revision and kind; durable time high-water before reply",
    "sleep": "explicit response issues one-use intent; position checkpoint precedes existing SLEEP_NOW path; no permission UI",
    "grant_ticket_ms": 120000,
    "add_key": "a:<immutable configuration revision>:<nonce>; Library assigned, bounded, deterministic local identity; stale deleted Add keys reject"
  }
}
