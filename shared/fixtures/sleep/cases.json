 "sources": {
  "_comment": "Not a recording: Pick from and Leave out as sets (docs/design/lock-screen.md R1, R1c, X1, X8). from/leave_out: the wire value (one item per line, as SETTINGS carries it) -> the stored value, one item per line. candidates: the order a pool refresh tries books in, from the books each picked source gives (lists: a dashboard list's books in the server's order; bag: the shuffle bag's next ids, one bag over the members of every picked library, smart scope and collection). check: one book against the Leave out rules (keep, out, or unknown: failed closed, X7).",
  "from": [
   {
    "name": "one list, as before",
    "wire": "want_to_read",
    "expect": "want_to_read"
   },
   {
    "name": "several, in the order picked",
    "wire": "discover\nscope:12\nup_next",
    "expect": "discover\nscope:12\nup_next"
   },
   {
    "name": "duplicates and bad items dropped, spaces trimmed",
    "wire": " up_next \nbogus\nscope:0\nup_next\ncollection:7",
    "expect": "up_next\ncollection:7"
   },
   {
    "name": "Library is every book: the others are part of it",
    "wire": "up_next\nlibrary\nscope:3",
    "expect": "library"
   },
   {
    "name": "Library alone",
    "wire": "library",
    "expect": "library"
   },
   {
    "name": "nothing valid: the default",
    "wire": "bogus\n",
    "expect": "up_next"
   },
   {
    "name": "empty: the default",
    "wire": "",
    "expect": "up_next"
   }
  ],
  "leave_out": [
   {
    "name": "rules, as before",
    "wire": "tag: Age:18 \nscope:12\nbogus\nscope:12",
    "expect": "tag:age:18\nscope:12"
   },
   {
    "name": "Library leaves out every book: the other rules are part of it",
    "wire": "tag:horror\nlibrary\ncollection:4",
    "expect": "library"
   },
   {
    "name": "dashboard lists are not Leave out rules",
    "wire": "up_next\ncollection:4",
    "expect": "collection:4"
   },
   {
    "name": "none",
    "wire": "",
    "expect": ""
   }
  ],
  "candidates": [
   {
    "name": "one list: its books in the server's order",
    "from": "up_next",
    "lists": {
     "up_next": [
      5,
      7,
      9
     ]
    },
    "bag": [],
    "expect": [
     5,
     7,
     9
    ],
    "fallback": null
   },
   {
    "name": "two lists: taken in turn, so neither crowds out the other",
    "from": "want_to_read\nup_next",
    "lists": {
