{
 "comment": "Per-key merges of shared settings (docs/design/companion-settings.md §4.4), read by the plugin's test_logic.lua and the companion's SettingsSyncTest. local/remote: key -> {v (wire), at (ms)}; a local key without at was never set on that side. remote_wins_tie: true on the plugin side. taken: the keys the merge takes, in schema order; expect: the wire values after applying them.",
 "cases": [
  {"name": "newer remote wins", "now": 1000000,
   "local": {"sync_on_sleep": {"v": "1", "at": 100}}, "remote": {"sync_on_sleep": {"v": "0", "at": 200}},
   "remote_wins_tie": true, "taken": ["sync_on_sleep"], "expect": {"sync_on_sleep": "0"}},
  {"name": "older remote loses", "now": 1000000,
   "local": {"sync_on_sleep": {"v": "0", "at": 300}}, "remote": {"sync_on_sleep": {"v": "1", "at": 200}},
   "remote_wins_tie": true, "taken": [], "expect": {"sync_on_sleep": "0"}},
  {"name": "regression: whole-set settings_at lost one of two changes to different keys",
   "comment": "Wi-Fi changed in KOReader at 100, the sleep hours in the companion at 200, while they couldn't talk. The old block merge took the companion's whole set and lost the Wi-Fi change.",
   "now": 1000000,
   "local": {"wifi_mode": {"v": "always_on", "at": 100}, "sleep_hours": {"v": "6", "at": 50}},
   "remote": {"wifi_mode": {"v": "jit", "at": 50}, "sleep_hours": {"v": "12", "at": 200}},
   "remote_wins_tie": true, "taken": ["sleep_hours"], "expect": {"wifi_mode": "always_on", "sleep_hours": "12"}},
  {"name": "tie goes to the companion (plugin side takes it)", "now": 1000000,
   "local": {"home_button": {"v": "smart", "at": 500}}, "remote": {"home_button": {"v": "bookorbit", "at": 500}},
   "remote_wins_tie": true, "taken": ["home_button"], "expect": {"home_button": "bookorbit"}},
  {"name": "tie goes to the companion (companion side keeps its own)", "now": 1000000,
   "local": {"home_button": {"v": "bookorbit", "at": 500}}, "remote": {"home_button": {"v": "smart", "at": 500}},
   "remote_wins_tie": false, "taken": [], "expect": {"home_button": "bookorbit"}},
  {"name": "never set here: the remote value is taken", "now": 1000000,
   "local": {"storage_limit_mb": {"v": "250"}}, "remote": {"storage_limit_mb": {"v": "500", "at": 1}},
   "remote_wins_tie": false, "taken": ["storage_limit_mb"], "expect": {"storage_limit_mb": "500"}},
  {"name": "invalid value ignored, never replaced by the default", "now": 1000000,
   "local": {"storage_limit_mb": {"v": "500", "at": 10}}, "remote": {"storage_limit_mb": {"v": "333", "at": 999}},
   "remote_wins_tie": true, "taken": [], "expect": {"storage_limit_mb": "500"}},
  {"name": "a time far in the future counts as now", "now": 1000000,
   "local": {"key_log": {"v": "1", "at": 2000000}}, "remote": {"key_log": {"v": "0", "at": 99999999999}},
   "remote_wins_tie": true, "taken": [], "expect": {"key_log": "1"}},
  {"name": "same value, newer time: taken so the sender sees the echo", "now": 1000000,
   "local": {"eob_auto": {"v": "1", "at": 10}}, "remote": {"eob_auto": {"v": "1", "at": 20}},
   "remote_wins_tie": true, "taken": ["eob_auto"], "expect": {"eob_auto": "1"}},
  {"name": "rules and text are normalised", "now": 1000000,
   "local": {}, "remote": {"sleep_leave_out": {"v": "tag: Age:18 \nscope:12\nbogus\nscope:12", "at": 5}, "sleep_text": {"v": "Line one\nline two", "at": 5}},
   "remote_wins_tie": true, "taken": ["sleep_leave_out", "sleep_text"], "expect": {"sleep_leave_out": "tag:age:18\nscope:12", "sleep_text": "Line one line two"}},
  {"name": "scope source accepted, junk refused", "now": 1000000,
   "local": {"sleep_from": {"v": "up_next", "at": 1}}, "remote": {"sleep_from": {"v": "collection:7", "at": 9}, "sleep_mode": {"v": "sideways", "at": 9}},
   "remote_wins_tie": true, "taken": ["sleep_from"], "expect": {"sleep_from": "collection:7"}},
  {"name": "Pick from and Leave out as sets (lock-screen.md R1c, X8): several kept in order, Library alone", "now": 1000000,
   "local": {"sleep_from": {"v": "up_next", "at": 1}, "sleep_leave_out": {"v": "", "at": 1}},
   "remote": {"sleep_from": {"v": "want_to_read\nscope:3\nbogus\nscope:3", "at": 9}, "sleep_leave_out": {"v": "tag:horror\nlibrary", "at": 9}},
   "remote_wins_tie": false, "taken": ["sleep_from", "sleep_leave_out"], "expect": {"sleep_from": "want_to_read\nscope:3", "sleep_leave_out": "library"}}
 ]
}
