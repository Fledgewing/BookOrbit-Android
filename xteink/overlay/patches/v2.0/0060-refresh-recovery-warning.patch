Subject: [PATCH] BookSync: recognize refresh failures independently of warning text

diff --git a/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp b/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
index d8489e5e..63935ea5 100644
--- a/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
+++ b/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
@@ -2760,7 +2760,7 @@ std::string BookOrbitCatalogBrowserActivity::viewStamp() const {
   if (refreshPaused) return "Paused — no Wi-Fi";
   if (regularRefresh) return tr(STR_ORBIFY_REFRESHING);
   if (mirrorShown.active) {
-    if (mirrorShown.finished && OrbifyMirror::snapshot().result.find("Stopped at ") == 0) return "Stopped";
+    if (mirrorShown.finished && OrbifyMirror::snapshot().stopped()) return "Stopped";
     char badge[40];
     orbify::mirror::badgeText(mirrorShown.percent, mirrorShown.finished, mirrorShown.failures, badge, sizeof(badge));
     return badge;
@@ -2802,7 +2802,7 @@ void BookOrbitCatalogBrowserActivity::paintMirrorBadge() {
 void BookOrbitCatalogBrowserActivity::drawMirrorPopup() const {
   if (mirrorShown.active && mirrorShown.finished) {
     const auto result = OrbifyMirror::snapshot().result;
-    if (result.find("Stopped at ") == 0) { OrbifyRefreshBadge::drawMessage(renderer, result.c_str()); return; }
+    if (OrbifyMirror::snapshot().stopped()) { OrbifyRefreshBadge::drawMessage(renderer, result.c_str()); return; }
   }
   if (mirrorPopupUntil == 0) return;
   OrbifyRefreshBadge::drawStartPopup(renderer, mirrorShown.percent);
