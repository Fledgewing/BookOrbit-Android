Subject: [PATCH] Orbify: orbify simulator build

Build the same overlay hooks in the desktop simulator for release tests.

diff --git a/lib/BookOrbitSync/BookOrbitSyncClient.cpp b/lib/BookOrbitSync/BookOrbitSyncClient.cpp
index c82786f..efda252 100644
--- a/lib/BookOrbitSync/BookOrbitSyncClient.cpp
+++ b/lib/BookOrbitSync/BookOrbitSyncClient.cpp
@@ -1084,11 +1084,43 @@ int BookOrbitSyncClient::orbifyRequest(const char* method, const std::string& pa
   lastTransportError = 0;
   if (!BOOKORBIT_STORE.hasCredentials()) return -1;
 #ifdef SIMULATOR
-  (void)method;
-  (void)path;
-  (void)jsonBody;
-  (void)replyPath;
-  return -1;
+  // Orbify's emulated release tests (xteink/test/e2e/): the same request over the simulator's
+  // host HTTP, as the sync's own calls above make it.
+  const std::string url = BOOKORBIT_STORE.getBaseUrl() + path;
+  HTTPClient http;
+  std::unique_ptr<WiFiClientSecure> secureClient;
+  WiFiClient plainClient;
+  if (isHttpsUrl(url)) {
+    secureClient.reset(new WiFiClientSecure);
+    secureClient->setInsecure();
+    http.begin(*secureClient, url.c_str());
+  } else {
+    http.begin(plainClient, url.c_str());
+  }
+  addAuthHeaders(http);
+  if (jsonBody) http.addHeader("Content-Type", "application/json");
+  int code = -1;
+  if (strcmp(method, "GET") == 0) {
+    code = http.GET();
+  } else if (strcmp(method, "POST") == 0) {
+    code = http.POST(jsonBody ? jsonBody : "");
+  } else if (strcmp(method, "PUT") == 0) {
+    code = http.PUT(jsonBody ? jsonBody : "");
+  }
+  if (code > 0 && replyPath) {
+    HalFile reply;
+    const String replyBody = http.getString();
+    if (!Storage.openFileForWrite("BookOrbit", replyPath, reply) ||
+        reply.write(reinterpret_cast<const uint8_t*>(replyBody.c_str()), replyBody.length()) != replyBody.length()) {
+      code = -1;
+    }
+    reply.close();
+  }
+  http.end();
+  lastHttpCode = code > 0 ? code : 0;
+  lastTransportError = code < 0 ? code : 0;
+  LOG_INF("BookOrbit", "%s %s -> %d", method, path.c_str(), code);
+  return code;
 #else
   const uint32_t freeHeap = ESP.getFreeHeap();
   const uint32_t heapFloor = requiredHeapFloor();
