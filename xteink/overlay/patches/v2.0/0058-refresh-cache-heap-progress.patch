diff --git a/lib/Memory/Memory.h b/lib/Memory/Memory.h
--- a/lib/Memory/Memory.h
+++ b/lib/Memory/Memory.h
@@ -233,3 +233,17 @@
 
 template <typename F>
 ScopedCleanup(F) -> ScopedCleanup<F>;
+
+// Cover working storage must not compete with the Wi-Fi PHY's internal RAM.
+inline HeapByteBuffer makeImageByteBufferNoThrow(size_t count) {
+  return psramHeapAvailable() ? makePsramByteBufferNoThrow(count) : makeHeapByteBufferNoThrow(count);
+}
+struct ImageObjectDeleter {
+  template<class T> void operator()(T* p) const {
+    if (p) { p->~T(); HeapByteBufferDeleter{}(reinterpret_cast<uint8_t*>(p)); }
+  }
+};
+template<class T> std::unique_ptr<T, ImageObjectDeleter> makeImageObjectNoThrow() {
+  auto bytes=makeImageByteBufferNoThrow(sizeof(T));
+  return std::unique_ptr<T, ImageObjectDeleter>(bytes ? new (bytes.release()) T() : nullptr);
+}
