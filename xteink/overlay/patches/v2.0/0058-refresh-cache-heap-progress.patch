 extern "C" esp_err_t __wrap_esp_wifi_start() {
+#if defined(BOARD_HAS_PSRAM)
+  // Leave the PHY enough internal RAM before its Wi-Fi task starts calibration.
+  // Preserve the existing transmit-power wrapper and its board ceiling.
+  if (!orbify::heap::catalogFits(heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
+                                heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT))) {
