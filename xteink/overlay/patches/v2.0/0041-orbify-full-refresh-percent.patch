-    RenderLock lock(*self);
-    self->statusMessage = line;
+// Patch 0041: one progress number for a Full refresh (docs/design/sqlite-cache.md "Xteink: the same
+// rule"). The walk takes one request per loop() when the reader has left the buttons alone for a
+// second and a list is on screen; between requests the catalog answers as usual.
+void BookOrbitCatalogBrowserActivity::tickMirror() {
+  constexpr unsigned long IDLE_MS = 1000;
+  const unsigned long now = millis();
+  const bool input = mappedInput.hasPendingActivity() || mappedInput.wasAnyPressed() || mappedInput.wasAnyReleased();
+  if (input) mirrorInputAt = now;
+  // The press that started the Full refresh does not close its popup: the next one does.
+  if (mirrorPopupUntil != 0 && !input) mirrorPopupArmed = true;
+  if (mirrorPopupUntil != 0 && ((mirrorPopupArmed && input) || now >= mirrorPopupUntil)) {
+    {
+      RenderLock lock(*this);
+      mirrorPopupUntil = 0;
+    }
+    LOG_INF("BookOrbit", "Catalog: Full refresh popup closed (%s)", input ? "a press" : "timeout");
+    requestUpdate();
+  }
+  if (!mirrorWalk.active()) {
+    // A Full refresh left unfinished (the catalog left, a reset) carries on here, badge only.
+    if (!mirrorResumeChecked && state == BrowserState::BROWSING && !offlineSession && WiFi.status() == WL_CONNECTED) {
+      mirrorResumeChecked = true;
+      if (OrbifyMirror::requested()) {
+        mirrorWalk.begin();
+        syncMirrorShown();
+        requestUpdate();
+      }
+    }
+    return;
+  }
+  if (mirrorWalk.finished()) {
+    if (now >= mirrorDoneUntil) {
+      mirrorWalk.end();
+      syncMirrorShown();
+      requestUpdate();  // the stamp comes back
+    }
+    return;
+  }
+  if (state != BrowserState::BROWSING || listOptions || now - mirrorInputAt < IDLE_MS) return;
+  if (WiFi.status() != WL_CONNECTED) {
+    LOG_INF("BookOrbit", "Catalog: Full refresh paused at %u%% (no network)", mirrorWalk.percent());
+    mirrorWalk.end();
+    syncMirrorShown();
+    requestUpdate();
+    return;
+  }
+  mirrorWalk.step();
+  syncMirrorShown();
+  if (mirrorWalk.finished()) {
+    mirrorDoneUntil = millis() + orbify::mirror::DONE_MS;
+    {
+      RenderLock lock(*this);
+      mirrorPopupUntil = 0;  // "Done" alone
+    }
+    LOG_INF("BookOrbit", "Catalog: Full refresh done (%u errors)", static_cast<unsigned>(mirrorWalk.failures()));
+    requestUpdate();  // "Done" / "Done with N errors" is wider than the %: the header is drawn again
+    return;
+  }
+  paintMirrorBadge();
+}
+
+void BookOrbitCatalogBrowserActivity::syncMirrorShown() {
+  RenderLock lock(*this);
+  mirrorShown.active = mirrorWalk.active();
+  mirrorShown.finished = mirrorWalk.finished();
+  mirrorShown.percent = mirrorWalk.percent();
+  mirrorShown.failures = mirrorWalk.failures();
+}
+
+void BookOrbitCatalogBrowserActivity::paintMirrorBadge() {
+  RenderLock lock(*this);
+  const unsigned percent = mirrorShown.percent;
+  if (mirrorBadgeW <= 0 || !orbify::mirror::badgeDue(mirrorBadgePainted, percent, mirrorBadgeAt, millis())) return;
+  char text[16];
+  orbify::mirror::badgeText(percent, false, 0, text, sizeof(text));
+  OrbifyRefreshBadge::repaintBadge(renderer, mirrorBadgeX, mirrorBadgeY, mirrorBadgeW, mirrorBadgeH, text);
+  mirrorBadgePainted = static_cast<int>(percent);
+  mirrorBadgeAt = millis();
+  LOG_INF("BookOrbit", "Catalog: Full refresh badge '%s' at %d,%d %dx%d (its rectangle only)", text, mirrorBadgeX,
+          mirrorBadgeY, mirrorBadgeW, mirrorBadgeH);
+}
+
+void BookOrbitCatalogBrowserActivity::drawMirrorPopup() const {
+  if (mirrorPopupUntil == 0) return;
+  OrbifyRefreshBadge::drawStartPopup(renderer, mirrorShown.percent);
+  if (!mirrorPopupLogged) {
+    mirrorPopupLogged = true;
+    LOG_INF("BookOrbit", "Catalog: Full refresh popup: about %u%%", mirrorShown.percent);
+  }
+}
+
+// While a Full refresh runs, the stamp's place keeps the width of "100%", so the title never moves
+// and the badge's rectangle stays the same between its repaints.
+int BookOrbitCatalogBrowserActivity::stampSlot(const int textWidth) const {
+  if (!mirrorShown.active || mirrorShown.finished) return textWidth;
+  return std::max(textWidth, OrbifyRefreshBadge::badgeWidth(renderer));
+}
+
+void BookOrbitCatalogBrowserActivity::noteBadge(const int x, const int y, const int w, const int h) const {
+  mirrorBadgeX = x;
+  mirrorBadgeY = y;
+  mirrorBadgeW = mirrorShown.active && !mirrorShown.finished ? w : 0;
+  mirrorBadgeH = h;
+  if (mirrorShown.active) {
+    mirrorBadgePainted = static_cast<int>(mirrorShown.percent);
+    mirrorBadgeAt = millis();
   }
-  self->requestUpdate();
 }
 #endif
