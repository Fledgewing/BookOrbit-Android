+    mirrorBadgeH = renderer.getLineHeight(SMALL_FONT_ID);
+    mirrorBadgeX = screen.x + screen.width - metrics.contentSidePadding - badgeW;
+    mirrorBadgeY = screen.y + metrics.topPadding + metrics.headerHeight + gap;
+    mirrorBadgeW = mirrorFinished ? 0 : badgeW;
+    OrbifyRefreshBadge::drawBadge(renderer, mirrorBadgeX, mirrorBadgeY, badgeW, mirrorBadgeH, badge);
+    mirrorBadgePainted = static_cast<int>(mirrorPercent);
+    mirrorBadgeAt = millis();
+    LOG_INF("BookOrbit", "Home refresh: Full refresh badge '%s' at %d,%d %dx%d", badge, mirrorBadgeX, mirrorBadgeY,
+            badgeW, mirrorBadgeH);
+    if (mirrorPopupUntil != 0) {
+      OrbifyRefreshBadge::drawStartPopup(renderer, mirrorPercent);
+      LOG_INF("BookOrbit", "Home refresh: Full refresh popup: about %u%%", mirrorPercent);
+    }
+  }
+#endif
   renderer.displayBuffer();
 }
