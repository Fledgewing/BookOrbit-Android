+// changed; Full refresh first saves the offline mirror (OrbifyMirror), then reloads the view
+// with the cache bypassed. Offline, either connects first.
+void BookOrbitCatalogBrowserActivity::refreshView(const bool full) {
+  const int level = static_cast<int>(navLevel);
+  LOG_INF("BookOrbit", "Catalog: %s of view %d%s", full ? "Full refresh" : "Refresh", level,
+          offlineSession ? " (offline: connecting)" : "");
+  if (WiFi.status() != WL_CONNECTED) {
+    {
+      RenderLock lock(*this);
+      state = BrowserState::LOADING;
+      statusMessage = tr(STR_CONNECTING);
+    }
+    requestUpdateAndWait();
+    if (!SavedWifiConnect::connect([] { return false; })) {
+      LOG_INF("BookOrbit", "Catalog: refresh could not connect");
+      viewNotUpdated[level] = true;
+      state = BrowserState::ERROR;
+      errorMessage = tr(STR_ORBIFY_COULDNT_CONNECT);
+      requestUpdate();
+      return;
+    }
+    offlineSession = false;
+    sdFontSystem.releaseForNetwork(renderer);
+  }
+  if (full) {
+    {
+      RenderLock lock(*this);
+      state = BrowserState::LOADING;
+      statusMessage = tr(STR_ORBIFY_FULL_REFRESH);
+    }
+    requestUpdateAndWait();
+    mirrorPaintedAt = millis();
+    // Asked for on the card first: a reset part-way resumes it at the next sleep sync.
+    OrbifyMirror::request();
+    const OrbifyMirror::Progress progress{this, &BookOrbitCatalogBrowserActivity::onMirrorStep};
+    OrbifyMirror::run(nullptr, 0, &progress);
+  }
+  // This session's own page copies would answer first: the view is read again.
+  BookOrbitCatalogListCache::clear();
+  OrbifyCache::ScopedMode mode(full ? orbify::cache::Mode::Full : orbify::cache::Mode::Refresh);
+  bool ok = true;
+  switch (navLevel) {
+    case NavLevel::Root:
+      ok = loadRoot(/*allowNetwork=*/true);
+      break;
+    case NavLevel::FacetList: {
+      const std::string id = facetSectionId;
+      const std::string title = facetTitle;
+      ok = loadFacetEntries(id, title, 1);
+      break;
+    }
+    case NavLevel::Books:
+      if (listIsLocal) {  // the card's own lists: nothing to ask the server
+        state = BrowserState::BROWSING;
+        requestUpdate();
+        break;
+      }
+      {
+        const BookOrbitBookQuery query = listQuery;
+        const std::string title = listTitle;
+        ok = loadBooks(query, title, 1, booksFromFacet);
+      }
+      break;
+  }
+  viewNotUpdated[level] = !ok;
+  LOG_INF("BookOrbit", "Catalog: %s %s", full ? "Full refresh" : "Refresh", ok ? "done" : "failed");
+}
+
+void BookOrbitCatalogBrowserActivity::markViewLoaded(const bool fromSessionList) {
+  const int level = static_cast<int>(navLevel);
+  // Back to a view read earlier this session keeps that view's stamp.
+  if (fromSessionList && viewLoadedAt[level] != 0) return;
+  viewLoadedAt[level] = offlineSession ? OrbifyMirror::savedAt() : nowEpoch();
+  viewNotUpdated[level] = false;
+}
+
+std::string BookOrbitCatalogBrowserActivity::viewStamp() const {
+  const int level = static_cast<int>(navLevel);
+  char out[64];
+  orbify::formatStamp(!offlineSession && WiFi.status() == WL_CONNECTED, viewLoadedAt[level], nowEpoch(),
+                      viewNotUpdated[level], out, sizeof(out));
+  return out;
+}
+
+void BookOrbitCatalogBrowserActivity::onMirrorStep(void* context, const size_t done, const size_t total) {
+  auto* self = static_cast<BookOrbitCatalogBrowserActivity*>(context);
+  // Each repaint is an e-ink refresh: a few seconds apart.
+  if (done < total && millis() - self->mirrorPaintedAt < 3000) return;
+  self->mirrorPaintedAt = millis();
+  char line[80];
+  snprintf(line, sizeof(line), tr(STR_ORBIFY_SAVING_OFFLINE), static_cast<unsigned>(done),
+           static_cast<unsigned>(total));
+  {
+    RenderLock lock(*self);
+    self->statusMessage = line;
+  }
+  self->requestUpdate();
+}
+#endif
