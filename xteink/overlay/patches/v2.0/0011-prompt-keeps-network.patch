Subject: [PATCH] BookSync: prompt keeps network

Keep the network session alive while its prompt is open.

diff --git a/include/CrossInkTailnetCuts.h b/include/CrossInkTailnetCuts.h
index f333c4d8..ee0bb49c 100644
--- a/include/CrossInkTailnetCuts.h
+++ b/include/CrossInkTailnetCuts.h
@@ -91,6 +91,15 @@
 #define CROSSINK_TAILNET_PACKED_ROWS 0
 #endif
 
+// A screen that waits for input in a boot that parked the framebuffer for Tailscale (the
+// BookOrbit sync's "which position to keep?"): the overlay first takes the framebuffer back
+// with WiFi and Tailscale kept up, so the choice runs over the kept connection. Only when it
+// does not fit is WiFi turned off; an upload chosen then restarts the BookOrbit sync with the
+// choice pre-answered (BOOKORBIT_SYNC_PAYLOAD_UPLOAD_LOCAL) instead of failing offline.
+#ifndef CROSSINK_TAILNET_PROMPT_KEEPS_NETWORK
+#define CROSSINK_TAILNET_PROMPT_KEEPS_NETWORK 0
+#endif
+
 #if CROSSINK_TAILNET_NET_LOOP_STACK
 // Logs the calling task's stack high-water mark (bytes never used), for the
 // network-boot loopTask stack cut. Defined in main.cpp.
diff --git a/src/SilentRestart.h b/src/SilentRestart.h
index 346181dd..bc2bc85b 100644
--- a/src/SilentRestart.h
+++ b/src/SilentRestart.h
@@ -53,6 +53,9 @@ constexpr uint32_t BOOKORBIT_SYNC_PAYLOAD_HAS_PARAGRAPH = 1u << 16;
 // (Mirrors the KOReader sync orientation payload.)
 constexpr uint32_t BOOKORBIT_SYNC_PAYLOAD_ORIENTATION_SHIFT = 17u;
 constexpr uint32_t BOOKORBIT_SYNC_PAYLOAD_ORIENTATION_MASK = 0x7u << BOOKORBIT_SYNC_PAYLOAD_ORIENTATION_SHIFT;
+// Bit 20 (CROSSINK_TAILNET_PROMPT_KEEPS_NETWORK): the user already chose "upload this device's
+// position" in a sync whose network was turned off for the prompt; this sync uploads it.
+constexpr uint32_t BOOKORBIT_SYNC_PAYLOAD_UPLOAD_LOCAL = 1u << 20;
 // BOOKORBIT_SLEEP_SYNC payload: Power was still held when the device went to sleep (a
 // long-press sleep), so that press belongs to the sleep gesture and must be released
 // before a press can wake the device out of the sync.
diff --git a/src/activities/reader/bookorbit/BookOrbitSyncActivity.cpp b/src/activities/reader/bookorbit/BookOrbitSyncActivity.cpp
index ca7a29ec..020b5c37 100644
--- a/src/activities/reader/bookorbit/BookOrbitSyncActivity.cpp
+++ b/src/activities/reader/bookorbit/BookOrbitSyncActivity.cpp
@@ -8,6 +8,7 @@
 #endif
 #include <HalClock.h>
 #include <I18n.h>
+#include <CrossInkTailnetCuts.h>
 #include <Logging.h>
 #include <Memory.h>
 #include <WallClock.h>
@@ -425,6 +426,14 @@ void BookOrbitSyncActivity::performSync() {
     if (!exchangeReadingData()) return;
   }
 
+  if (preAnsweredUpload && (result == BookOrbitSyncClient::OK || result == BookOrbitSyncClient::NOT_FOUND)) {
+    // Asked and answered in the boot before (its network was off for the prompt).
+    LOG_INF("BookOrbit", "Prompt answered before the restart: uploading this device's position");
+    preAnsweredUpload = false;
+    performUpload();
+    return;
+  }
+
   if (result == BookOrbitSyncClient::NOT_FOUND) {
     if (smartSyncEnabled() || sleepSync) {
       LOG_DBG("BookOrbit", "Smart sync: no remote progress, uploading local %.6f", localProgress.percentage);
@@ -637,6 +646,23 @@ void BookOrbitSyncActivity::performUpload() {
     fail(tr(STR_SYNC_FAILED_MSG));
     return;
   }
+#if CROSSINK_TAILNET_PROMPT_KEEPS_NETWORK
+  // The overlay turned WiFi off to show the prompt (the framebuffer did not fit beside
+  // Tailscale): the upload cannot run in this boot. Restart into the sync with the choice.
+  if (!sleepSync && tailnet_prompt_dropped_network()) {
+    const uint32_t orientationPayload =
+        readerOrientation < CrossPointSettings::ORIENTATION_COUNT
+            ? (static_cast<uint32_t>(readerOrientation) + 1) << BOOKORBIT_SYNC_PAYLOAD_ORIENTATION_SHIFT
+            : 0;
+    const uint32_t paragraphPayload =
+        currentParagraphIndex ? (BOOKORBIT_SYNC_PAYLOAD_HAS_PARAGRAPH | *currentParagraphIndex) : 0;
+    const uint32_t payload = BOOKORBIT_SYNC_PAYLOAD_UPLOAD_LOCAL | orientationPayload | paragraphPayload;
+    LOG_INF("BookOrbit", "Prompt: restarting with the choice saved (upload this device's position)");
+    syncSession.reset();
+    silentRestartToNetwork(NetworkBootTarget::BOOKORBIT_SYNC, payload);
+    return;  // only reached when a deep sleep in progress suppressed the restart
+  }
+#endif
   {
     RenderLock lock(*this);
     state = UPLOADING;
diff --git a/src/activities/reader/bookorbit/BookOrbitSyncActivity.h b/src/activities/reader/bookorbit/BookOrbitSyncActivity.h
index 1d4417a7..eda7b3eb 100644
--- a/src/activities/reader/bookorbit/BookOrbitSyncActivity.h
+++ b/src/activities/reader/bookorbit/BookOrbitSyncActivity.h
@@ -54,6 +54,9 @@ class BookOrbitSyncActivity final : public Activity, private BookOrbitSyncReport
         remotePosition{},
         localProgress(std::move(localKoPos)) {}
 
+  // The restart payload carried BOOKORBIT_SYNC_PAYLOAD_UPLOAD_LOCAL: upload without asking.
+  void preAnswerUpload() { preAnsweredUpload = true; }
+
   void onEnter() override;
   void onExit() override;
   void loop() override;
@@ -109,6 +112,7 @@ class BookOrbitSyncActivity final : public Activity, private BookOrbitSyncReport
   bool stopIfWoken();
 
   State state = WIFI_SELECTION;
+  bool preAnsweredUpload = false;  // preAnswerUpload()
   std::string statusMessage;
   std::string documentHash;
 
diff --git a/src/main.cpp b/src/main.cpp
index a274b676..ba991bb3 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -727,6 +727,7 @@ bool startGlobalBookOrbitSync(const bool networkBootReady, const uint32_t payloa
   auto syncActivity = makeUniqueNoThrow<BookOrbitSyncActivity>(
       renderer, mappedInputManager, epubPath, spineIndex, pageNumber, totalPagesInSpine, std::move(localKoPos),
       std::move(localChapterName), paragraphIndex, networkBootReady, readerOrientation, sleepSync);
+  if (syncActivity && (payload & BOOKORBIT_SYNC_PAYLOAD_UPLOAD_LOCAL) != 0) syncActivity->preAnswerUpload();
   if (!syncActivity) {
     LOG_ERR("MAIN", "OOM: BookOrbit sync activity (free=%u maxAlloc=%u)", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
     return false;
