-STR_ORBIFY_SAVED_OFFLINE: "Saved for offline"
-STR_ORBIFY_NOT_SAVED_OFFLINE: "Not saved for offline yet"
+STR_ORBIFY_SAVED_OFFLINE: "Last Full refresh"
+STR_ORBIFY_NOT_SAVED_OFFLINE: "No Full refresh yet"
