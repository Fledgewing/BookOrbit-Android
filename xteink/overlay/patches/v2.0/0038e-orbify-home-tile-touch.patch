@@ -1158,24 +1168,40 @@ void HomeActivity::loopBookOrbitHome() {
 
 #if CROSSINK_TAILNET_ORBIFY_MIRROR
   // Patch 0037: the sync tile is Home's refresh, as the ⟳ is the catalog's. A tap (Confirm)
-  // refreshes Home and its lists; a long press (Confirm held, on the X4) starts a Full refresh,
-  // which the Home's refresh boot runs with "Full refresh · saving for offline N/M".
-  const auto startFullRefresh = [] {
+  // refreshes Home and its lists; a hold (Confirm held, on the X4) starts a Full refresh, which the
+  // Home's refresh boot runs with "Full refresh · saving for offline N/M".
+  //
+  // Patch 0038 (X4 Pro, .167: a hold did nothing, a tap failed, the next tap started a Full
+  // refresh): the tile no longer takes the SDK's screen long press. That fires at 500 ms, an
+  // ordinary e-ink tap's length, and suppresses the contact before the tile was even checked, so a
+  // slow tap on or beside the tile was lost, and a slow tap on it was a Full refresh. The tile
+  // times the contact itself: released before HOME_FULL_REFRESH_HOLD_MS is a tap, held that long is
+  // a hold. The restart's popup names which ("Refreshing…", "Full refresh").
+  const auto startFullRefresh = [this] {
     LOG_INF("ORB", "Home: Full refresh asked for from the sync tile");
     OrbifyMirror::request();
+    setSilentRestartMessage(tr(STR_ORBIFY_FULL_REFRESH));
     silentRestartToNetwork(NetworkBootTarget::BOOKORBIT_HOME_REFRESH);
   };
   int heldX = 0;
   int heldY = 0;
-  if (mappedInput.wasScreenLongPress(heldX, heldY)) {
+  unsigned long heldMs = 0;
+  if (!bookOrbitFullRefreshHeld && mappedInput.isScreenTouchTapCandidate(heldX, heldY, heldMs) &&
+      heldMs >= HOME_FULL_REFRESH_HOLD_MS) {
     const auto* stop = bookOrbitUi->stopContaining(heldX, heldY);
     if (stop != nullptr && stop->action == BookOrbitHomeUi::Action::Refresh) {
+      bookOrbitFullRefreshHeld = true;
+      mappedInput.suppressCurrentTouchContact();
       startFullRefresh();
       return;
     }
   }
   if (bookOrbitFullRefreshHeld) {
-    if (!mappedInput.isPressed(MappedInputManager::Button::Confirm)) bookOrbitFullRefreshHeld = false;
+    int x = 0;
+    int y = 0;
+    if (!mappedInput.isPressed(MappedInputManager::Button::Confirm) && !mappedInput.isScreenTouchHeld(x, y)) {
+      bookOrbitFullRefreshHeld = false;
+    }
     return;
   }
   if (mappedInput.isPressed(MappedInputManager::Button::Confirm) &&
@@ -1293,6 +1319,8 @@ void HomeActivity::activateBookOrbitStop(const BookOrbitHomeUi::Stop& stop) {
       break;
     }
     case BookOrbitHomeUi::Action::Refresh:
