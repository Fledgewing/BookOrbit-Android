Subject: [PATCH] Orbify: orbify home tile touch

Align the Home tile touch target and consume the menu-closing swipe.

diff --git a/src/SilentRestart.h b/src/SilentRestart.h
index be42ab3..c224f48 100644
--- a/src/SilentRestart.h
+++ b/src/SilentRestart.h
@@ -114,6 +114,9 @@ static_assert(isNetworkBootTargetValue(static_cast<uint32_t>(NetworkBootTarget::
                   isNetworkBootTargetValue(static_cast<uint32_t>(NetworkBootTarget::BOOKORBIT_HOME_SHELVES)),
               "Every network boot target must pass RTC target validation");
 
+// Patch 0038: the popup the next silent restart shows instead of "Loading" (a string that lives
+// for the program, e.g. tr(...)); used once.
+void setSilentRestartMessage(const char* message);
 bool silentRestart();                                            // home screen
 bool silentRestartToReader(bool cleanImageBaseOnEntry = false);  // currently-open EPUB (APP_STATE.openEpubPath)
 // Reboots immediately after an activity releases exclusive raw storage.
