+  int currentPage() const { return stops.currentPageIndex(); }
+  // Patch 0038: the current page's first stop with this action, null when none.
+  const Stop* pageStopWith(const Action action) const {
+    const int page = stops.currentPageIndex();
+    const int first = stops.pageFirstStopIndex(page);
+    for (int i = first; i < first + stops.pageStopCount(page); i++) {
