+namespace {
+struct Version { unsigned parts[4]{}; int channel = 2; bool valid = false; };
+bool number(const char*& p, unsigned& out) {
+  if (*p < '0' || *p > '9') return false;
+  const char* start = p;
+  while (*p >= '0' && *p <= '9') {
+    unsigned digit = *p++ - '0';
+    if (out > (UINT_MAX - digit) / 10) return false;
+    out = out * 10 + digit;
+  }
+  return p - start == 1 || *start != '0';
+}
+Version parse(const char* p) {
+  Version v;
+  if (!p) return v;
+  for (int i = 0; i < 3; ++i) {
+    if (!number(p, v.parts[i])) return v;
+    if (i < 2 && *p++ != '.') return v;
+  }
+  if (*p == '-') {
+    ++p;
+    if (strncmp(p, "preview.", 8) == 0) { v.channel = 0; p += 8; }
+    else if (strncmp(p, "rc.", 3) == 0) { v.channel = 1; p += 3; }
+    else if (strncmp(p, "0.test.", 7) == 0) { v.channel = -1; p += 7; }
+    else return v;
+    if (!number(p, v.parts[3]) || v.parts[3] == 0) return v;
+  }
+  if (*p == '+') {
+    ++p;
+    bool component = false;
+    for (; *p; ++p) {
+      if (*p == '.') { if (!component) return v; component = false; }
+      else if ((*p >= '0' && *p <= '9') || (*p >= 'A' && *p <= 'Z') ||
+               (*p >= 'a' && *p <= 'z') || *p == '-') component = true;
+      else return v;
+    }
+    if (!component) return v;
+  }
+  v.valid = *p == '\0';
+  return v;
+}
+bool legacy(const char* p) {
+  if (!p) return false;
+  unsigned unused = 0;
+  for (int i = 0; i < 4; ++i) {
+    unused = 0;
+    if (!number(p, unused)) return false;
+    if (i < 3 && *p++ != '.') return false;
+  }
+  return true;
+}
+}
+
+bool validBookSync(const char* version) { return parse(version).valid; }
+
+int compare(const char* latestBookSync, const char* currentBookSync,
+            const char* latestLegacy, const char* currentLegacy) {
+  const Version a = parse(latestBookSync), b = parse(currentBookSync);
+  if (a.valid != b.valid) return a.valid ? 1 : -1;
+  if (!a.valid) return firmware_version::compare(latestLegacy, currentLegacy);
+  for (int i = 0; i < 3; ++i)
+    if (a.parts[i] != b.parts[i]) return a.parts[i] > b.parts[i] ? 1 : -1;
+  if (a.channel != b.channel) return a.channel > b.channel ? 1 : -1;
+  if (a.parts[3] != b.parts[3]) return a.parts[3] > b.parts[3] ? 1 : -1;
+  // Bridge rebuilds share a BookSync identity; their legacy counter still orders them.
+  if (legacy(latestLegacy) && legacy(currentLegacy))
+    return firmware_version::compare(latestLegacy, currentLegacy);
+  return 0;
+}
+
 void keep(ReleaseJsonParser::Release& newest, const ReleaseJsonParser::Release& candidate, const Filter& filter) {
   const char* version = versionOf(candidate.tagName, filter.tagPrefix);
   if (version == nullptr || !firmware_version::isComparable(version)) return;
-  if (candidate.prerelease && !filter.includePrereleases) return;
+  if (candidate.booksyncVersion[0] && (!validBookSync(candidate.booksyncVersion) ||
+      parse(candidate.booksyncVersion).channel < 0)) return;
+  const Version book = parse(candidate.booksyncVersion);
+  if ((candidate.prerelease || (book.valid && book.channel < 2)) && !filter.includePrereleases) return;
   if (newest.tagFound &&
-      firmware_version::compare(version, versionOf(newest.tagName, filter.tagPrefix)) <= 0) {
+      compare(candidate.booksyncVersion, newest.booksyncVersion,
+              version, versionOf(newest.tagName, filter.tagPrefix)) <= 0) {
     return;
   }
   newest = candidate;
