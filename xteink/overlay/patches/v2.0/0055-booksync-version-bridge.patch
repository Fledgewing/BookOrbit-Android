 // The version part of `tag`: what follows the prefix, or nullptr when `tag` lacks it.
 const char* versionOf(const char* tag, const char* prefix);
 
+// BookSync versions use preview.N < rc.N < stable; metadata has no precedence.
+// Empty BookSync versions identify legacy firmware and sort below every BookSync version.
+bool validBookSync(const char* version);
+int compare(const char* latestBookSync, const char* currentBookSync,
+            const char* latestLegacy, const char* currentLegacy);
+
