+// Orbify: "orbify_signature" is exactly 2 * n hex digits; anything else leaves the asset unsigned.
+bool decodeSignatureHex(uint8_t* out, size_t n, const char* value, size_t valueLen) {
+  if (valueLen != 2 * n) return false;
+  for (size_t i = 0; i < valueLen; ++i) {
+    const char c = value[i];
+    const int v = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+    if (v < 0) return false;
+    out[i / 2] = static_cast<uint8_t>((i % 2) ? (out[i / 2] | v) : (v << 4));
+  }
+  return true;
+}
+
