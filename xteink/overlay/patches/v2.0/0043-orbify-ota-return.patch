Subject: [PATCH] BookSync: return to the OTA screen after updating

Route a completed installation back to its update screen without a network join.
Implementation: orbify/OtaReturn; no verifier changes.

diff --git a/src/activities/settings/OtaUpdateActivity.cpp b/src/activities/settings/OtaUpdateActivity.cpp
index 7f5bd50d..22618a83 100644
--- a/src/activities/settings/OtaUpdateActivity.cpp
+++ b/src/activities/settings/OtaUpdateActivity.cpp
@@ -5,6 +5,7 @@
 #include <WiFi.h>
 
 #include "AppVersion.h"
+#include "orbify/OtaReturn.h"
 #include "CrossPointSettings.h"
 #include "MappedInputManager.h"
 #include "SdCardFontSystem.h"
@@ -91,6 +92,13 @@ void OtaUpdateActivity::onWifiSelectionComplete(const bool success) {
 void OtaUpdateActivity::onEnter() {
   Activity::onEnter();
   sdFontSystem.releaseLoadedFont(renderer);
+  returnedAfterUpdate = OrbifyOtaReturn::consume();
+  if (returnedAfterUpdate) {
+    LOG_INF("OTA", "Updated to v%s", AppVersion::version());
+    state = NO_UPDATE;
+    requestUpdate();
+    return;  // no Wi-Fi join or update check on the return screen
+  }
 
   if (hasActiveWifiConnection()) {
     onWifiSelectionComplete(true);
@@ -186,7 +194,9 @@ void OtaUpdateActivity::render(RenderLock&&) {
         renderer, safe, UI_10_FONT_ID, y,
         (std::to_string(updater.getProcessedSize()) + " / " + std::to_string(updater.getTotalSize())).c_str());
   } else if (state == NO_UPDATE) {
-    UITheme::drawCenteredText(renderer, safe, UI_10_FONT_ID, top, tr(STR_NO_UPDATE), true, EpdFontFamily::BOLD);
+    const std::string message = returnedAfterUpdate ? std::string("Updated to v") + AppVersion::version()
+                                                    : tr(STR_NO_UPDATE);
+    UITheme::drawCenteredText(renderer, safe, UI_10_FONT_ID, top, message.c_str(), true, EpdFontFamily::BOLD);
     const auto labels = mappedInput.mapLabels(mappedInput.withBackArrow(tr(STR_BACK)), "", "", "");
     GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
   } else if (state == FAILED) {
@@ -311,6 +321,7 @@ void OtaUpdateActivity::loop() {
   }
 
   if (state == SHUTTING_DOWN) {
+    OrbifyOtaReturn::installed();
     ESP.restart();
   }
 }
