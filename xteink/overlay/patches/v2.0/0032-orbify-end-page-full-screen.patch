diff --git a/src/activities/reader/EndOfBookOptions.h b/src/activities/reader/EndOfBookOptions.h
index ad8fbfc3..ee7e406b 100644
--- a/src/activities/reader/EndOfBookOptions.h
+++ b/src/activities/reader/EndOfBookOptions.h
@@ -25,7 +25,9 @@ class MappedInputManager;
 class EndOfBookOptions {
  public:
   // Orbify (patch 0028): the reader reads the request with takeOrbifyResult().
-  enum class Action { None, Redraw, OpenBook, GoHome, LastPage, Orbify };
+  // Consumed (patch 0032): the page took the input and nothing changes; the reader must not
+  // hand it on to its own page-turn, Back-to-Home or gesture handling.
+  enum class Action { None, Redraw, OpenBook, GoHome, LastPage, Orbify, Consumed };
 
   static constexpr size_t MAX_SUGGESTIONS = 3;
 
@@ -57,6 +59,9 @@ class EndOfBookOptions {
   // Orbify's End-of-Book page (orbify/EndPage.h) instead of the folder menu: the EPUB reader
   // calls this before loadOnce(). Its status row toggles the book's finish through the reader.
   void enableOrbify() { orbifyWanted = true; }
+  // What the book's own metadata says, for the title block and the offline series and author
+  // rows (patch 0032). Before loadOnce().
+  void setOrbifyBook(OrbifyEndPage::BookInfo info) { orbifyBook = std::move(info); }
   OrbifyEndPage::Result takeOrbifyResult() { return std::move(orbifyResult); }
   void orbifyFinishedChanged(bool finished);
 #endif
@@ -95,6 +100,10 @@ class EndOfBookOptions {
 #if CROSSINK_TAILNET_ORBIFY_FINISH
   bool orbifyWanted = false;
   bool orbifyTouch = false;
+  OrbifyEndPage::BookInfo orbifyBook;
+  // millis() of the page's first draw: a tap whose finger went down before it is the tail of
+  // the gesture that turned to this page, never a choice on it (patch 0032).
+  std::atomic<unsigned long> orbifyShownAt{0};
   std::unique_ptr<OrbifyEndPage> orbify;
   OrbifyEndPage::Result orbifyResult;
   Action orbifyAct(OrbifyEndPage::Result result);
diff --git a/src/activities/reader/EpubReaderActivity.cpp b/src/activities/reader/EpubReaderActivity.cpp
