--- a/src/activities/reader/EpubReaderActivity.cpp
+++ b/src/activities/reader/EpubReaderActivity.cpp
@@ -3832,7 +3832,19 @@ void EpubReaderActivity::loop() {
       }
 #if CROSSINK_TAILNET_ORBIFY_FINISH
       // Orbify (patch 0028): the End-of-Book page with the book's status, next and suggestions.
-      if (endOfBookOptions) endOfBookOptions->enableOrbify();
+      if (endOfBookOptions) {
+        endOfBookOptions->enableOrbify();
+        // Patch 0032: the title block and the offline series row come from the book itself.
+        OrbifyEndPage::BookInfo info;
+        info.title = epub->getTitle();
+        info.author = epub->getAuthor();
+        Epub::SyncMetadata meta;
+        if (epub->loadSyncMetadata(meta)) {
+          info.series = meta.series;
+          info.seriesIndex = meta.seriesIndex;
+        }
+        endOfBookOptions->setOrbifyBook(std::move(info));
+      }
 #endif
     }
     if (endOfBookOptions) {
