+#if CROSSINK_TAILNET_BACKGROUND_SYNC
+void EpubReaderActivity::tickBackgroundSync() {
+  if (!epub || !BookOrbitBackgroundSync::enabled()) return;
+  // Never beside a page turn or a render: only when both are idle, and the position is read
+  // under the render lock (as the reader's own sync reads it) only if it is free right now.
+  if (mappedInput.hasPendingActivity() || RenderLock::peek()) return;
+  RenderLock lock(*this, RenderLock::Mode::Try);
+  if (!lock.ownsLock() || !section) return;
+  const int page = section->currentPage;
+  const char* trigger = BookOrbitBackgroundSync::observe(epub->getPath().c_str(), currentSpineIndex, page, millis());
+  if (!trigger) return;
+  BookOrbitBackgroundSync::Position position;
+  position.spineIndex = currentSpineIndex;
+  position.page = page;
+  // estimatedTotalPages, as the sync menu uses: pageCount is only the built-so-far watermark.
+  position.pageCount = std::max(1, static_cast<int>(section->estimatedTotalPages()));
+  std::optional<uint16_t> paragraphIndex;
+  std::optional<uint16_t> listItemIndex;
+  getSyncPageAnchors(*section, page, paragraphIndex, listItemIndex);
+  if (paragraphIndex) {
+    position.hasParagraph = true;
+    position.paragraphIndex = *paragraphIndex;
+  }
+  if (listItemIndex) {
+    position.hasListItem = true;
+    position.listItemIndex = *listItemIndex;
+  }
+  // The sync reads the book's saved progress nowhere: the position travels with the request.
+  BookOrbitBackgroundSync::start(epub->getPath().c_str(), position, trigger);
+}
+#endif
+
