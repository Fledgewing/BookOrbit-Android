     // BookSync (patch 0035): the ⟳ at the right, its "updated …" stamp beside it.
     const std::string stamp = viewStamp();
     if (mappedInput.hasTouchHardware()) {
+      // Patch 0038: the stamp is drawn here, just left of the controls. Passed as the header's
