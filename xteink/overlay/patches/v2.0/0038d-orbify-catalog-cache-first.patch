Subject: [PATCH] BookSync: catalog cache first

Open a current saved catalog without first joining Wi-Fi.

diff --git a/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp b/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
index c8e9ceff..36e06077 100644
--- a/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
+++ b/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
@@ -545,6 +545,25 @@ void BookOrbitCatalogBrowserActivity::onEnter() {
 #endif
     return;
   }
+#if CROSSINK_TAILNET_ORBIFY_MIRROR
+  // Patch 0038, cache-first (the user's rule, .167): a catalog opened in place (the X4s) with a
+  // saved copy that is not stale opens from the cache without Wi-Fi. The network comes up only on
+  // ⟳, for a view the cache does not hold (connectForMiss), or from the Home tile. Stale = the
+  // 7-day Full refresh is due or the Home's refresh learned a new library version (dueNow()).
+  // Before, every open joined Wi-Fi first (WifiSelectionActivity), even offline with Tailscale off.
+  if (!networkBoot && pendingDownload.fileId == 0 && entryLink.bookId == 0 && WiFi.status() != WL_CONNECTED) {
+    const auto due = OrbifyMirror::dueNow();
+    if (orbify::mirror::catalogFromCache(OrbifyMirror::saved(), due)) {
+      LOG_INF("BookOrbit", "Catalog: opening from the cache, no Wi-Fi (saved %lu)",
+              static_cast<unsigned long>(OrbifyMirror::savedAt()));
+      offlineSession = true;
+      cacheFirst = true;
+      openEntryViews();
+      return;
+    }
+    LOG_INF("BookOrbit", "Catalog: the saved copy is %s; connecting", orbify::mirror::dueName(due));
+  }
+#endif
   state = BrowserState::CHECK_WIFI;
   requestUpdate();
   checkAndConnectWifi();
@@ -640,6 +659,10 @@ void BookOrbitCatalogBrowserActivity::onWifiSelectionComplete(const bool connect
     downloadBook(link.bookId, link.title, link.replacePath, /*openExisting=*/link.replacePath.empty());
     return;
   }
+  openEntryViews();
+}
