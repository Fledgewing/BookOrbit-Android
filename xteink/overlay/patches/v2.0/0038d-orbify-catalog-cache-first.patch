       return;
     }
     const auto& metrics = UITheme::getInstance().getMetrics();
@@ -2659,6 +2706,25 @@ void BookOrbitCatalogBrowserActivity::refreshView(const bool full) {
   LOG_INF("BookOrbit", "Catalog: %s %s", full ? "Full refresh" : "Refresh", ok ? "done" : "failed");
