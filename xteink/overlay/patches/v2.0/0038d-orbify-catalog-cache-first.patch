+bool BookOrbitCatalogBrowserActivity::connectForMiss() {
+  if (!cacheFirst || WiFi.status() == WL_CONNECTED) return false;
+  cacheFirst = false;  // one try: offline, the view's error says so
+  LOG_INF("BookOrbit", "Catalog: not in the cache; connecting");
+  {
+    RenderLock lock(*this);
+    state = BrowserState::LOADING;
+    statusMessage = tr(STR_CONNECTING);
+  }
+  requestUpdateAndWait();
+  if (!SavedWifiConnect::connect([] { return false; })) {
+    LOG_INF("BookOrbit", "Catalog: could not connect for a view not in the cache");
+    return false;
+  }
+  offlineSession = false;
+  sdFontSystem.releaseForNetwork(renderer);
+  return true;
+}
