+// Exercise the same cycle handler as Confirm, including its durable save and reload.
+bool SettingsActivity::simulatorTestUpdateChannel() {
+  selectedCategoryIndex = categoryCount - 1;
+  rebuildSettingsLists();
+  const unsigned initial = SETTINGS.otaChannel;
+  for (unsigned step = 1; step <= 3; ++step) {
+    const auto row = std::find_if(currentSettings->begin(), currentSettings->end(), [](const SettingInfo& item) {
+      return item.valuePtr == &CrossPointSettings::otaChannel;
+    });
+    if (row == currentSettings->end() || row->type != SettingType::ENUM || currentSettingUsesOptionMenu(*row)) return false;
+    selectedSettingIndex = static_cast<int>(std::distance(currentSettings->begin(), row)) + 1;
+    toggleCurrentSetting();
+    if (optionPopup.isActive() || SETTINGS.otaChannel != (initial + step) % 3) return false;
+    SETTINGS.otaChannel = 255;
+    if (!SETTINGS.loadFromFile() || SETTINGS.otaChannel != (initial + step) % 3) return false;
+  }
+  LOG_INF("SET", "BookSync channel cycle passed (initial=%u)", initial);
+  return true;
+}
