 #include "orbify/CacheStore.h"
 #endif
@@ -30,14 +31,25 @@ constexpr char COVER_DIR[] = "/.crosspoint/bookorbit_home";
 constexpr uint32_t MAGIC = 0x484F4242;  // "BBOH"
 constexpr uint16_t VERSION = 3;         // 2: continueTotal, 3: shelves chosen in the settings
 constexpr size_t HEADER_SIZE = 8;       // magic, version, sizeof(BookOrbitHomeSnapshot)
-// One boot's worth of covers: the rest comes with the next sync.
+// One boot's worth of covers: the rest comes with the next sync. Patch 0037: on the X4s (PSRAM) a
+// whole Home's worth, so a sync catches up instead of leaving most covers to later ones.
+#if defined(BOARD_HAS_PSRAM)
+constexpr int MAX_COVER_FETCHES = 30;
+#else
 constexpr int MAX_COVER_FETCHES = 8;
+#endif
 // Shelves and rows hold 11 covers; the older ones stay until a sync finds more than this.
 constexpr size_t MAX_COVER_FILES = 30;
 // The sync client's handshake discipline, per cover transfer: wolfSSL churns through
 // tens of KB, and the SDK's response headers go into containers that abort on OOM.
 constexpr uint32_t MIN_FREE_HEAP_FOR_FETCH = 42 * 1024;
+#if defined(BOARD_HAS_PSRAM)
+// Patch 0037: wolfSSL's large buffers go to PSRAM on the X4s (allocations over 4 KB); a 20 KB
+// internal block refused fetches there that fit (an X4 Pro at 28 KB free, 8 KB largest).
+constexpr uint32_t MIN_MAX_ALLOC_FOR_FETCH = 8 * 1024;
+#else
 constexpr uint32_t MIN_MAX_ALLOC_FOR_FETCH = 20 * 1024;
+#endif
 constexpr uint32_t MIN_MAX_ALLOC_FOR_DECODE = 54 * 1024;
 constexpr uint32_t MIN_PLAUSIBLE_EPOCH = 1700000000;
 constexpr char BOOK_STATE_ROOT[] = "/.crosspoint";
@@ -79,6 +91,15 @@ bool readHeader(HalFile& file) {
   return magic == MAGIC && version == VERSION && size == sizeof(BookOrbitHomeSnapshot);
 }
 
+// Room for one more request. On a connection already open (the Home's own session, or the one the
+// sleep sync lends, patch 0037) only OrbifyHeap's floor beside it: no handshake to pay.
+bool roomToFetch() {
+  if (BookOrbitCatalogClient::keptConnection() != nullptr) {
+    return ESP.getFreeHeap() >= OrbifyHeap::KEPT_CONNECTION_MIN_FREE;
+  }
+  return ESP.getFreeHeap() >= MIN_FREE_HEAP_FOR_FETCH && ESP.getMaxAllocHeap() >= MIN_MAX_ALLOC_FOR_FETCH;
+}
