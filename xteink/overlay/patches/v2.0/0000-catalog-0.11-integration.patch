+    {"title", StrId::STR_TITLE, false},
+    {"author", StrId::STR_LIBRARY_AUTHOR_LAST_NAME, false},
+    {"recently_read", StrId::STR_BOOKORBIT_SORT_RECENTLY_READ, true},
