+    orbify::cache::CoverOnDisk disk;
+    disk.present = hasKept && kept.version != book.coverVersion && Storage.exists(oldPath);
+    disk.version = kept.version;
+    disk.file = disk.present ? orbify::cache::CoverFile::Ok : orbify::cache::CoverFile::Missing;
+    disk.hasEtag = !kept.etag.empty();
+    const auto plan = orbify::cache::planCover(OrbifyCache::currentMode(), true, book.coverVersion, disk, false);
+    std::string etag;
+    const auto result = BookOrbitCatalogClient::downloadThumbnail(
+        book.id, pending, shouldStop, plan.action == orbify::cache::CoverAction::Conditional ? kept.etag : "", &etag);
+    if (result != HttpDownloader::OK && HttpDownloader::lastHttpStatus == 304) {
+      // Every size of the kept cover takes the new version's name.
+      const int both[2][2] = {{sizes.rowWidth, sizes.rowHeight}, {sizes.shelfWidth, sizes.shelfHeight}};
+      for (const auto& wh : both) {
+        char from[64];
+        char to[64];
+        coverPath(old, wh[0], wh[1], from, sizeof(from));
+        coverPath(book, wh[0], wh[1], to, sizeof(to));
+        if (Storage.exists(from)) Storage.rename(from, to);
+      }
+      OrbifyCache::coverStored(book.id, book.coverVersion, kept.etag);
+      LOG_INF("BookOrbit", "Cover of book %ld unchanged (304)", static_cast<long>(book.id));
+      return;
+    }
+    if (result == HttpDownloader::OK) OrbifyCache::coverStored(book.id, book.coverVersion, etag);
+#else
     const auto result = BookOrbitCatalogClient::downloadThumbnail(book.id, pending, shouldStop);
+#endif
     if (result != HttpDownloader::OK) {
       LOG_ERR("BookOrbit", "Cover of book %ld not fetched (err=%d, http=%d)", static_cast<long>(book.id),
               static_cast<int>(result), HttpDownloader::lastHttpStatus);
