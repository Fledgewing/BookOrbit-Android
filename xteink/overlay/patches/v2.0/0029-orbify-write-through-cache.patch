 using ReplySink = std::function<bool(const uint8_t* data, size_t len, size_t announced)>;
 
+#if CROSSINK_TAILNET_ORBIFY_CACHE
+}  // namespace
+// Orbify's write-through cache (src/orbify/CacheStore.cpp) learns of every write that went through.
+void orbifyCacheAfterWrite(const char* method, const std::string& url, const char* body, size_t bodyLength,
+                           int status) __attribute__((weak));
+namespace {
+#endif
+
 int sendBookOrbitRequest(const char* method, const std::string& url, const JsonBody* payload, const ReplySink& onBody) {
   s_lastBodyRefusal = BodyRefusal::None;
   const bool pooled = s_session != nullptr;
@@ -488,6 +496,10 @@ int sendBookOrbitRequest(const char* method, const std::string& url, const JsonB
   CROSSINK_TAILNET_TLS_ARENA_LOG("BookOrbit request");
 #if TAILNET_PROBE_CATALOG_LIVE
   tailnet_probe_window_end("BookOrbit request", probeFirstBytes ? "whole request (no body)" : "body");
+#endif
+#if CROSSINK_TAILNET_ORBIFY_CACHE
+  if (orbifyCacheAfterWrite && strcmp(method, "GET") != 0)
+    orbifyCacheAfterWrite(method, url, payload ? reinterpret_cast<const char*>(payload->bytes()) : nullptr, payload ? payload->length() : 0, code);
 #endif
   return code;
 }
