+int BookOrbitSyncClient::orbifyRequest(const char* method, const std::string& path, const char* jsonBody,
+                                       const char* replyPath) {
+  lastHttpCode = 0;
+  lastTransportError = 0;
+  if (!BOOKORBIT_STORE.hasCredentials()) return -1;
+#ifdef SIMULATOR
+  (void)method;
+  (void)path;
+  (void)jsonBody;
+  (void)replyPath;
+  return -1;
+#else
+  const uint32_t freeHeap = ESP.getFreeHeap();
+  const uint32_t heapFloor = requiredHeapFloor();
+  if (freeHeap < heapFloor) {
+    LOG_ERR("BookOrbit", "Insufficient heap for %s %s: %u free (need %u)", method, path.c_str(), (unsigned)freeHeap,
+            (unsigned)heapFloor);
+    return -1;
+  }
+  JsonBody body;
+  if (jsonBody && !body.copy(jsonBody, strlen(jsonBody))) return -1;
+  HalFile reply;
+  if (replyPath && !Storage.openFileForWrite("BookOrbit", replyPath, reply)) return -1;
+  const int code = sendBookOrbitRequest(method, BOOKORBIT_STORE.getBaseUrl() + path, jsonBody ? &body : nullptr,
+                                        [&](const uint8_t* data, const size_t len, size_t) {
+                                          return !replyPath || reply.write(data, len) == len;
+                                        });
+  if (replyPath) reply.close();
+  lastHttpCode = code > 0 ? code : 0;
+  lastTransportError = code < 0 ? code : 0;
+  LOG_INF("BookOrbit", "%s %s -> %d", method, path.c_str(), code);
+  return code;
+#endif
+}
