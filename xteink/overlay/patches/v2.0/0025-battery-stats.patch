+#if CROSSINK_TAILNET_BATTERY_STATS
+  // CrossInk-Tailnet patch 0025: refreshes since the last call, full (FULL/HALF) and
+  // partial (FAST/grayscale); the battery stats take them into each record.
+  void takeRefreshCounts(uint16_t& full, uint16_t& partial) {
+    full = statsFull;
+    partial = statsPartial;
+    statsFull = statsPartial = 0;
+  }
+
+ private:
+  uint16_t statsFull = 0, statsPartial = 0;
+  void countRefresh(const bool full) {
+    uint16_t& n = full ? statsFull : statsPartial;
+    if (n < UINT16_MAX) n++;
+  }
+#else
+ private:
+  void countRefresh(bool) {}
+#endif
+
  private:
   void beginHardware();
   bool hardwareReady = false;
