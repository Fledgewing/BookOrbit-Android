+  silentRebootPayload =
+      (sleepSyncPayload & ~BOOKORBIT_SLEEP_SYNC_PAYLOAD_POWER_HELD) | BOOKORBIT_SLEEP_SYNC_PAYLOAD_SLEEP_NOW;
+  silentRebootMagic = SILENT_REBOOT_MAGIC;
