+            SLEEP_SYNC_WAKE_GRACE_MS);
+    clearSilentRestartReaderPageBuild();
+    silentRebootTarget = 0;
+    silentRebootPayload = 0;
+    silentRebootMagic = SLEEP_SYNC_WAKE_MAGIC;
+  } else {
+    LOG_ERR("SLP", "BookOrbit sleep sync still running %lu s past its %lu s budget; restarting to sleep",
+            SLEEP_SYNC_BUDGET_GRACE_MS / 1000, SLEEP_SYNC_BUDGET_MS / 1000);
