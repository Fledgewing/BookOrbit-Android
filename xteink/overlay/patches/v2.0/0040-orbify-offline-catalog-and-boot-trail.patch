Subject: [PATCH] BookSync: offline catalog and boot trail

Avoid a catalog request before its network boot has started.

diff --git a/src/main.cpp b/src/main.cpp
index 8ac475c4..1d83e3d2 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -382,6 +382,8 @@ RTC_NOINIT_ATTR library::ScanSleepToken libraryScanSleepToken;
 // Patch 0038: the last step this run reached (orbify/core/BootTrail.h), for the next boot's log.
 RTC_NOINIT_ATTR uint32_t orbifyBootTrailWord;
 void orbifyBootStep(const orbify::boottrail::Step step) { orbifyBootTrailWord = orbify::boottrail::pack(step); }
+// Patch 0040: the reset that started this run, so a run that stops early names it (after a panic).
+RTC_NOINIT_ATTR uint32_t orbifyBootTrailReset;
 
 // Definitions for SilentRestart.h. RTC_NOINIT survives ESP.restart() but not power loss.
 RTC_NOINIT_ATTR uint32_t silentRebootMagic;
@@ -1914,9 +1916,11 @@ void setup() {
   BoardConfig::holdPowerRails();
   // Read the previous run before recording this boot.
   const orbify::boottrail::Step lastRunStep = orbify::boottrail::unpack(orbifyBootTrailWord);
+  const int lastRunReset = orbify::boottrail::unpackReset(orbifyBootTrailReset);
   orbifyBootStep(orbify::boottrail::Step::SetupStarted);
 
   const esp_reset_reason_t rawResetReason = esp_reset_reason();
+  orbifyBootTrailReset = orbify::boottrail::packReset(static_cast<int>(rawResetReason));
   if (rawResetReason != ESP_RST_DEEPSLEEP &&
       !(rawResetReason == ESP_RST_SW && silentRebootMagic == SILENT_REBOOT_MAGIC)) {
     ProgressBookIterator::resetLegacyLookups();
@@ -1974,7 +1978,12 @@ void setup() {
     // a run that stopped before deep sleep or loop(): the step it stopped at.
     const bool firmwareRestart = rawResetReason == ESP_RST_SW || rawResetReason == ESP_RST_DEEPSLEEP;
     if (orbify::boottrail::stoppedEarly(lastRunStep, firmwareRestart)) {
-      LOG_ERR("BOOT", "Last run stopped at: %s", orbify::boottrail::name(lastRunStep));
+      if (lastRunReset >= 0) {
+        LOG_ERR("BOOT", "Last run stopped at: %s (it started after reset=%d(%s))", orbify::boottrail::name(lastRunStep),
+                lastRunReset, resetReasonName(static_cast<esp_reset_reason_t>(lastRunReset)));
+      } else {
+        LOG_ERR("BOOT", "Last run stopped at: %s", orbify::boottrail::name(lastRunStep));
+      }
     } else {
       LOG_INF("BOOT", "Last run ended at: %s", orbify::boottrail::name(lastRunStep));
     }
@@ -2070,6 +2079,7 @@ void setup() {
   }
 #endif
   trustedtime::init();
+  orbifyBootStep(orbify::boottrail::Step::ClockRead);
 
 #if FREEINK_DEVICE_X4 || FREEINK_DEVICE_X3
   LOG_INF("MAIN", "Hardware detect: %s", gpio.deviceIsX3() ? "X3" : "X4");
@@ -2169,6 +2179,7 @@ void setup() {
   display.startBegin();
 
   HalSystem::checkPanic();
+  orbifyBootStep(orbify::boottrail::Step::StorageReady);
 
   if (!PluginBundle::recoverPending()) LOG_ERR("PLUG", "Plugin install recovery pending");
   // I2C light capabilities must be known before settings validate saved gestures.
@@ -2230,6 +2241,7 @@ void setup() {
   UITheme::getInstance().reload();
   ButtonNavigator::setMappedInputManager(mappedInputManager);
   logBootHeap("boot state ready");
+  orbifyBootStep(orbify::boottrail::Step::StateLoaded);
   // Silent restarts are invisible recovery steps, so they always retain the
   // current light state rather than applying wake or schedule policy.
   const bool wasLightOnBeforeSleep =
@@ -2541,6 +2553,7 @@ void setup() {
     activityManager.goToReader(path, false, allowFastInitialReaderRefresh, false, quickResumeFrameVisible);
   }
 
+  orbifyBootStep(orbify::boottrail::Step::ActivityStarted);
   // The sleep sync paints nothing: the sleep screen stays on the panel.
   if ((resume == BootResume::Silent || resume == BootResume::Network) && !sleepSyncBoot) {
     // Block until the first paint physically completes. refreshDisplay()
diff --git a/src/network/BookOrbitCatalogClient.cpp b/src/network/BookOrbitCatalogClient.cpp
index d4f2c42e..e2260c17 100644
--- a/src/network/BookOrbitCatalogClient.cpp
+++ b/src/network/BookOrbitCatalogClient.cpp
@@ -138,7 +138,15 @@ bool fetchJson(const std::string& url, const FilterBuilder& buildFilter, JsonDoc
   // in the last minute or there is no network; else the request below, whose reply is kept, and
   // the saved reply again if the request fails.
   const OrbifyCache::Lookup cached = OrbifyCache::lookup(url);
-  if (cached.serve && !cached.fetch) parsePath = cached.path.c_str();
+  // Patch 0040: offline with nothing saved, no request (orbify::cache::readStep). The cache-first
+  // catalog (0038) runs with Wi-Fi never started; a request then panicked in lwIP (X4 Pro, .194,
+  // a list's next page). The caller connects (connectForMiss) or shows its error.
+  const orbify::cache::ReadStep step = orbify::cache::readStep({cached.serve, cached.fetch});
+  if (step == orbify::cache::ReadStep::Miss) {
+    LOG_INF("BookOrbit", "Catalog: not saved, and the network is off: %s", url.c_str());
+    return false;
+  }
+  if (step == orbify::cache::ReadStep::Saved) parsePath = cached.path.c_str();
 #endif
 
   // Two attempts: TLS on the C3 runs with a few KB of headroom, so a fetch can fail
