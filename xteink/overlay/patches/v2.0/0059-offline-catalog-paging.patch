Subject: [PATCH] BookSync: consult every SD cache before a blocking catalog fetch

Ordinary refresh saves 100-row replies, not session-list pages. Resolve those
locally before the browser decides it needs a Loading screen. Cache probes
never enter HTTP, including when the radio is already connected.

diff --git a/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp b/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
index 020e706c..53fb18f4 100644
--- a/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
+++ b/src/activities/browser/bookorbit/BookOrbitCatalogBrowserActivity.cpp
@@ -2332,6 +2332,9 @@ void BookOrbitCatalogBrowserActivity::loop() {
       // so a finger can walk a long listing the way the buttons already do.
       const auto swipe = mappedInput.wasSwipe();
       if (swipe == MappedInputManager::SwipeDir::Up || swipe == MappedInputManager::SwipeDir::Down) {
+#ifdef SIMULATOR
+        const unsigned long pageTurnBegan = millis();
+#endif
         if (swipe == MappedInputManager::SwipeDir::Up) {
           const int wantedCount = topIndex + 2 * visibleRows;
           while (loadedEnd() < wantedCount && hasMorePages()) {
@@ -2345,6 +2348,12 @@ void BookOrbitCatalogBrowserActivity::loop() {
         topIndex = scrollListBy(topIndex, delta, visibleRows, loadedEnd());
         if (!revealRow(topIndex)) topIndex = windowStart;
         if (topIndex != previousTop) requestUpdate();
+#ifdef SIMULATOR
+        // Wait for the actual list paint, so the budget includes rendering as well as SD reads.
+        requestUpdateAndWait();
+        LOG_INF("BookOrbit", "Catalog page turn: from=%d to=%d elapsedMs=%lu", previousTop, topIndex,
+                millis() - pageTurnBegan);
+#endif
         return;
       }
       // Prefetch at the page turn: after a forward move onto the last loaded
@@ -2623,6 +2632,9 @@ void BookOrbitCatalogBrowserActivity::render(RenderLock&&) {
   // WIFI_SELECTION: the Wi-Fi screen is only pushed on the next loop, and a network
   // boot paints the catalog before that, with no listing loaded yet.
   if (state == BrowserState::CHECK_WIFI || state == BrowserState::LOADING || state == BrowserState::WIFI_SELECTION) {
+#ifdef SIMULATOR
+    LOG_INF("BookOrbit", "Catalog blocking paint: %s", statusMessage.c_str());
+#endif
     renderer.drawCenteredText(UI_10_FONT_ID, pageHeight / 2, statusMessage.c_str());
     const auto labels = mappedInput.mapLabels(tr(STR_BACK), "", "", "");
     GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
diff --git a/src/activities/browser/bookorbit/BookOrbitCatalogListCache.cpp b/src/activities/browser/bookorbit/BookOrbitCatalogListCache.cpp
