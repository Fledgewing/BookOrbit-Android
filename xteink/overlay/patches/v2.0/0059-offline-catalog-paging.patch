+  }
 
   JsonDocument doc;
   if (deserializeJson(doc, text) != DeserializationError::Ok || !doc["items"].is<JsonArray>()) return false;
@@ -243,10 +249,16 @@ void saveFacetPage(const std::string& sectionId, const int page, const BookOrbit
 
 bool loadBooksPage(const BookOrbitBookQuery& query, const int page, BookOrbitBookPage& outPage) {
 #if CROSSINK_TAILNET_ORBIFY_MIRROR
-  if(OrbifyBulk::active() && query.query.empty()) return BookOrbitCatalogClient::fetchBooks(query,page,outPage);
+  if(OrbifyBulk::active() && query.query.empty()) return BookOrbitCatalogClient::fetchBooks(query,page,outPage, /*allowNetwork=*/false);
 #endif
   std::string text;
-  if (!readJsonStringFile(cachePathForKey(booksCacheKey(query, page)), text)) return false;
+  if (!readJsonStringFile(cachePathForKey(booksCacheKey(query, page)), text)) {
+#if CROSSINK_TAILNET_ORBIFY_CACHE
+    return BookOrbitCatalogClient::fetchBooks(query, page, outPage, /*allowNetwork=*/false);
+#else
+    return false;
+#endif
+  }
 
   JsonDocument doc;
   if (deserializeJson(doc, text) != DeserializationError::Ok || !doc["items"].is<JsonArray>()) return false;
diff --git a/src/network/BookOrbitCatalogClient.cpp b/src/network/BookOrbitCatalogClient.cpp
index dc47200d..c01ce3cd 100644
--- a/src/network/BookOrbitCatalogClient.cpp
+++ b/src/network/BookOrbitCatalogClient.cpp
@@ -175,7 +175,7 @@ using FilterBuilder = std::function<void(JsonDocument&)>;
 // tens of KB. Buffering them in a std::string aborts on OOM (throwing operator new with
 // -fno-exceptions), so stream the body to a temp file on SD instead and parse it from
 // there with a filter that keeps only the handful of fields we actually read.
-bool fetchJson(const std::string& url, const FilterBuilder& buildFilter, JsonDocument& outDoc) {
+bool fetchJson(const std::string& url, const FilterBuilder& buildFilter, JsonDocument& outDoc, const bool allowNetwork = true) {
   constexpr char TMP_PATH[] = "/.crosspoint/bookorbit_catalog.json";
   CatalogRequestLock networkLock(catalogNetworkMutex, std::defer_lock);
   BookOrbitCatalogClient::lastFetchBadResponse = false;
@@ -196,6 +196,10 @@ bool fetchJson(const std::string& url, const FilterBuilder& buildFilter, JsonDoc
     JsonDocument filter(ORBIFY_CATALOG_JSON_ALLOCATOR);buildFilter(filter);
     if(OrbifyCache::readWindow(url,filter.as<JsonVariantConst>(),outDoc))return true;
   }
+  // A browser cache probe includes every saved representation (bulk, refreshed
+  // 100-row windows, and exact replies). A miss must not acquire a radio hold,
+  // connect, or enter HTTP, even if Wi-Fi is currently connected.
+  if (!allowNetwork && (!cached.serve || cached.fetch)) return false;
   OrbifyWifi::Hold miss(OrbifyWifi::Owner::OfflineMiss, !cached.hasEntry);
   if (!cached.hasEntry) OrbifyWifi::simulatorIdleOffProbe();
   // Patch 0040: offline with nothing saved, no request (orbify::cache::readStep). The cache-first
@@ -208,6 +212,8 @@ bool fetchJson(const std::string& url, const FilterBuilder& buildFilter, JsonDoc
   }
   OrbifyWifi::Hold requestRadio(OrbifyWifi::Owner::Catalog, step == orbify::cache::ReadStep::Request);
   if (step == orbify::cache::ReadStep::Saved) parsePath = cached.path.c_str();
+#else
+  if (!allowNetwork) return false;
 #endif
 
   // Two attempts: TLS on the C3 runs with a few KB of headroom, so a fetch can fail
@@ -805,7 +811,7 @@ HttpDownloader::DownloadError BookOrbitCatalogClient::downloadThumbnail(const in
   return result;
 }
 
-bool BookOrbitCatalogClient::fetchBooks(const BookOrbitBookQuery& query, const int page, BookOrbitBookPage& outPage) {
+bool BookOrbitCatalogClient::fetchBooks(const BookOrbitBookQuery& query, const int page, BookOrbitBookPage& outPage, const bool allowNetwork) {
   outPage = BookOrbitBookPage{};
   if (!BOOKORBIT_STORE.hasCredentials()) return false;
 
@@ -815,7 +821,7 @@ bool BookOrbitCatalogClient::fetchBooks(const BookOrbitBookQuery& query, const i
       bookOrbitSetFilter(filter, R"({"section":{"books":[{"id":true,"title":true,"authors":true,"formats":true}]}})");
     };
     JsonDocument doc(ORBIFY_CATALOG_JSON_ALLOCATOR);
-    if (!fetchJson(booksUrl(query, page, PAGE_SIZE), buildFilter, doc)) return false;
+    if (!fetchJson(booksUrl(query, page, PAGE_SIZE), buildFilter, doc, allowNetwork)) return false;
     JsonArrayConst books = doc["section"]["books"].as<JsonArrayConst>();
     outPage.books.reserve(books.size());
     for (JsonObjectConst item : books) {
@@ -844,7 +850,7 @@ bool BookOrbitCatalogClient::fetchBooks(const BookOrbitBookQuery& query, const i
     }
   };
   JsonDocument doc(ORBIFY_CATALOG_JSON_ALLOCATOR);
-  if (!fetchJson(url, buildFilter, doc)) return false;
+  if (!fetchJson(url, buildFilter, doc, allowNetwork)) return false;
 
   outPage.page = doc["page"] | page;
   outPage.total = doc["total"] | 0;
@@ -867,7 +873,7 @@ bool BookOrbitCatalogClient::fetchBooks(const BookOrbitBookQuery& query, const i
 }
 
 bool BookOrbitCatalogClient::fetchSectionEntries(const std::string& sectionId, const int page,
-                                                 BookOrbitFacetPage& outPage) {
+                                                 BookOrbitFacetPage& outPage, const bool allowNetwork) {
   outPage = BookOrbitFacetPage{};
   if (!BOOKORBIT_STORE.hasCredentials()) return false;
 
@@ -887,7 +893,7 @@ bool BookOrbitCatalogClient::fetchSectionEntries(const std::string& sectionId, c
                        R"({"page":true,"total":true,"size":true,"hasNext":true,"items":[{"id":true,"title":true,"count":true,"seriesId":true}]})");
   };
   JsonDocument doc(ORBIFY_CATALOG_JSON_ALLOCATOR);
-  if (!fetchJson(url, buildFilter, doc)) return false;
+  if (!fetchJson(url, buildFilter, doc, allowNetwork)) return false;
 
   outPage.page = doc["page"] | page;
   outPage.hasNext = doc["hasNext"] | false;
