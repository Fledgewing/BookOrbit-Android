@@ -197,10 +197,16 @@ void saveCatalogCounts(const BookOrbitCatalogCounts& counts) {
 
 bool loadFacetPage(const std::string& sectionId, const int page, BookOrbitFacetPage& outPage) {
 #if CROSSINK_TAILNET_ORBIFY_MIRROR
-  if(OrbifyBulk::active()) return BookOrbitCatalogClient::fetchSectionEntries(sectionId,page,outPage);
+  if(OrbifyBulk::active()) return BookOrbitCatalogClient::fetchSectionEntries(sectionId,page,outPage, /*allowNetwork=*/false);
