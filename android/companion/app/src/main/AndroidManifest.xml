<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android's own "Allow" prompt for the deviceidle allowlist (BatteryRow). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-update from GitHub releases (README "Updates"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Setup's one-tap KOReader patch install writes koreader/patches/ (targetSdk 28: legacy storage). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Optional, granted only over USB (install-usb.sh, "grant-screen-saver"): Orbit switches the
         screen saver to its sleep screen and back (docs/design/lock-screen.md P1). It writes only the
         three screen-saver keys (SleepSystem.KEYS, SleepGuardTest). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Orbit">

        <!-- HOME: invisible; starts KOReader with "home", or shows the launcher page. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/home_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Orbit.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Also opened by the patch (SHOW_LAUNCHER): Home pressed on BookOrbit home. -->
        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/home_name">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SHOW_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Opened by the patch with FLAG_ACTIVITY_NEW_TASK: own task, so Back returns to KOReader. -->
        <activity
            android:name=".AppsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/apps_name"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SHOW_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StatusActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SHOW_STATUS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".SetupActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".SetupBatteryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".SetupDetailsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- Clicker buttons in other apps (android/docs/BTKEYS-DESIGN.md). Switched on by the user in Settings › Accessibility. -->
        <service
            android:name=".ClickerService"
            android:exported="true"
            android:label="@string/clicker_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clicker_service" />
        </service>

        <!-- "Orbit clicker keys": Send-key actions (android/docs/BTKEYS-DESIGN.md "Send key"). Enabled by the user; never their default. -->
        <service
            android:name=".OrbitKeysIme"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <receiver
            android:name=".KeyboardReceiver"
            android:exported="false" />

        <activity
            android:name=".ClickersActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".CaptureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".ClickActionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".HomeAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".BatteryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- Orbify's mode (docs/design/addon-mode.md): the first-run choice and Settings › Mode. -->
        <activity
            android:name=".ModeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- Add-on restarts: the plugin starts this just before KOReader quits (RELAUNCH_UI). -->
        <activity
            android:name=".RelaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Orbit.Invisible">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.RELAUNCH_UI" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".DailyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".AttentionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <!-- The patch's "Fix now" in KOReader's setup box (android/docs/INTERFACE.md). -->
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SHOW_SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings PIN keypad; SHOW_PIN is the patch's locked Orbit menu (android/docs/INTERFACE.md). -->
        <activity
            android:name=".PinActivity"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SHOW_PIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsSectionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".SettingChoiceActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".LeaveOutActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".RecommendedReviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".GuardedAppsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- USB-only PIN recovery: only the shell holds DUMP (android/docs/SETUP.md "Forgot the PIN"). -->
        <receiver
            android:name=".PinResetReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.RESET_PIN" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".LicensesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- PackageInstaller session results for self-updates. -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <service
            android:name=".OrbitService"
            android:exported="false" />

        <!-- The sleep screen (docs/design/lock-screen.md): Orbit's screen saver, started only by the
             system at sleep (BIND_DREAM_SERVICE); its settings page and preview, opened from KOReader's
             Orbit menu (SHOW_SLEEP, SLEEP_PREVIEW); the picture sink's alarm. -->
        <service
            android:name=".SleepDream"
            android:exported="true"
            android:label="@string/sleep_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <activity
            android:name=".SleepScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SHOW_SLEEP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SleepPreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="net.fledgewing.orbitcompanion.action.SLEEP_PREVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <!-- KOReader's commands (android/docs/INTERFACE.md): call() checks the calling UID against
             the pinned KOReader first (CallerTrust, docs/design/security.md). -->
        <provider
            android:name=".CommandProvider"
            android:authorities="net.fledgewing.orbitcompanion.commands"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- The system's broadcasts and the companion's own alarms only: not exported. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
